# Copy to .env, then run with: node --env-file=.env bin/mcp-agent-tester.mjs ...
# A real environment variable always wins over the file.

# The model, through OpenRouter (https://openrouter.ai). This spends money, a little:
# a 50-tool server explored in about 50 tool calls cost $0.003 to $0.005 with a small
# model on the flex tier, and nothing with a ":free" model. Every run has a hard cap
# (--max-cost, $0.05 by default). Create the key at https://openrouter.ai/settings/keys
# with a credit limit. `lib/openrouter.mjs` is the only file that reads it.
OPENROUTER_API_KEY=your-key-here

# The credential of the server under test. The variable name is whatever your target
# file says in "auth.env". Use a key made for this test, with the narrowest scopes that
# let the agent do its job, and revoke it afterwards.
MY_SERVER_API_KEY=your-test-key-here
